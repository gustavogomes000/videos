# ---------------------------------------------------------------------------
# Copie para .env.local e preencha. Nada aqui vai para o navegador, exceto
# as três variáveis com o prefixo NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloque-a-anon-key
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key
SUPABASE_STORAGE_BUCKET=tiktok-media

# Acesso à ferramenta (uma pessoa só: você)
APP_PASSWORD=troque-por-uma-senha-longa
APP_ENCRYPTION_KEY=troque-por-outra-string-longa
CRON_SECRET=troque-por-uma-terceira-string

# Domínio público. Em produção é obrigatório: o callback do TikTok precisa bater.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# App do TikTok — só para publicar sozinho (modo API).
# Sem estas duas linhas, tudo funciona em modo assistido.
# ---------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Ajustes finos (opcional)
# TIKTOK_API_BASE=https://open.tiktokapis.com
# TIKTOK_AUTH_BASE=https://www.tiktok.com
# TICK_BUDGET_MS=45000
# TIKTOK_CHUNK_SIZE=5242880

# Só para rodar a migration via `npm run db:push` (opcional — dá para colar
# o SQL no editor do Supabase em vez disso).
# Supabase: Project Settings > Database > Connection string (URI)
SUPABASE_DB_URL=
